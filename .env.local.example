# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real credentials.

# --- Midtrans -----------------------------------------------------------
# Dashboard → Settings → Access Keys
# Sandbox keys are prefixed "SB-"; the app derives the correct Snap host
# from that prefix, so no extra flag is needed on the client.

# Server key. SERVER-SIDE ONLY — signs transactions and verifies webhooks.
MIDTRANS_SERVER_KEY=your-midtrans-server-key

# Client key. Exposed to the browser for the Snap popup (this is expected).
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=your-midtrans-client-key

# "false" for sandbox, "true" for production.
MIDTRANS_IS_PRODUCTION=false

# --- Site ---------------------------------------------------------------
# Fully-qualified origin, no trailing slash. Used for canonical URLs,
# hreflang, the sitemap, JSON-LD and the Midtrans finish-redirect.
NEXT_PUBLIC_SITE_URL=https://jeepsunrisebali.com
